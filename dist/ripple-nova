#!/bin/sh
# Opens the Ripple Control Center window. It needs root for the EC: without a password through sudo
# when install.sh set up its sudoers rule, otherwise through polkit (a password prompt).
lock=/run/ripple-nova-gui.lock
# Already running? Then do not start a second root GUI (it would double every popup), and do not ask
# for anything. The running window can be brought back from the dash.
if [ -e "$lock" ] && ! flock -n "$lock" true 2>/dev/null; then
	exit 0
fi
if sudo -n -l @BINDIR@/rcc-gui >/dev/null 2>&1; then
	exec sudo -n @BINDIR@/rcc-gui "$@"
fi
# pkexec starts with a clean environment, so the display variables are passed through.
set --
for v in WAYLAND_DISPLAY XDG_RUNTIME_DIR DISPLAY XAUTHORITY; do
	eval "val=\${$v}"
	[ -n "$val" ] && set -- "$@" "$v=$val"
done
exec pkexec env "$@" @BINDIR@/rcc-gui
